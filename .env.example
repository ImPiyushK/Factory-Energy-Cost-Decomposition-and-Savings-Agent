# Copy to .env and fill in. NEVER commit .env (keys stay out of Git).
LLM_PROVIDER=mock            # mock | openai | anthropic | google | ollama
LLM_MODEL=mock-template      # e.g. gpt-6-luna / claude-haiku-4-5-20251001 / gemini-3.8-flash / llama3.1:8b
MOCK_LLM=true                # true => deterministic template provider, no network
OLLAMA_BASE_URL=http://host.docker.internal:11434

# API keys (only needed for the selected provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=

# Store / paths
DB_PATH=data/energy_agent.db
DATA_DIR=data

# Analytical settings
RECON_TOLERANCE=0.05         # sub-meter vs main reconciliation tolerance (stated, per spec 4.5)
CDD_BASE=18                  # cooling/heating degree-day base, deg C
NIGHT_START=22               # night window start hour (inclusive)
NIGHT_END=6                  # night window end hour (exclusive)
EMISSION_FACTOR_KG_PER_KWH=  # leave empty if provided by the data pack; agent will flag if missing
LLM_TEMPERATURE=0
